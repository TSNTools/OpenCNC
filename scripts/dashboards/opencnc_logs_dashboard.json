          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "hamedkarbasi93-kafka-datasource",
            "uid": "cfz4vv44j5v5sf"
          },
          "topicName": "opencnc.latencies.json",
          "messageFormat": "json",
          "autoOffsetReset": "lastN",
          "partition": "all",
          "lastN": 200,
          "timestampMode": "message"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "time",
                "timestamp",
                "config_app_latency_ms",
